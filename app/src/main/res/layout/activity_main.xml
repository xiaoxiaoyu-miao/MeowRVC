<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========== 状态栏 ========== -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- ========== 模式切换 ==========
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/modeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/modeClassic"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/mode_classic" />

            <com.google.android.material.chip.Chip
                android:id="@+id/modeAi"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_ai" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:id="@+id/classicPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"> -->

        <!-- 模式切换 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/modeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/modeVad"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="录音变声" />

            <com.google.android.material.chip.Chip
                android:id="@+id/modeRealtime"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时变声" />
        </com.google.android.material.chip.ChipGroup>
        <LinearLayout
            android:id="@+id/aiPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- 模型管理 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/rvc_model_title"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:id="@+id/tvModelHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/rvc_help"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/modelList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <!-- 模型状态 -->
            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/rvc_no_model"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="后端 "
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/backendSwitch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:singleSelection="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportOnnx"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="导入 ONNX 模型" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteModel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/rvc_delete" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBackend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- AI 参数 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/rvc_params"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:id="@+id/tvF0Key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderF0Key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="0"
                android:valueFrom="-15"
                android:valueTo="15" />

            <TextView
                android:id="@+id/tvProtect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderProtect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="0.33"
                android:valueFrom="0.0"
                android:valueTo="1.0" />

            <TextView
                android:id="@+id/tvLatency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderLatency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="1"
                android:valueFrom="0"
                android:valueTo="5"
                android:stepSize="0.01" />

            <TextView
                android:id="@+id/tvNoise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderNoise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="5"
                android:stepSize="1" />

            <TextView
                android:id="@+id/tvEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="5"
                android:stepSize="1" />

            <TextView
                android:id="@+id/tvNoiseGate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderNoiseGate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="150"
                android:stepSize="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="输出降噪" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDenoise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="音域滤波" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchVocalRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音高提取 "
                    android:textAppearance="?attr/textAppearanceTitleSmall" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/pitchSelector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/pitchFcpe"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FCPE"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/pitchRmvpe"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RMVPE" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/pitchAuto"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自相关" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="高级"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:id="@+id/tvCrossfade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCrossfade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="2048"
                android:valueFrom="256"
                android:valueTo="4096"
                android:stepSize="256" />

            <TextView
                android:id="@+id/tvVadEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderVadEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="500"
                android:valueFrom="100"
                android:valueTo="2000"
                android:stepSize="100" />

            <TextView
                android:id="@+id/tvVadFrames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderVadFrames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="300"
                android:valueFrom="50"
                android:valueTo="600"
                android:stepSize="50" />

            <TextView
                android:id="@+id/tvOverlap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderOverlap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="4"
                android:valueFrom="1"
                android:valueTo="8"
                android:stepSize="1" />

            <TextView
                android:id="@+id/tvIndexPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="索引: 未选择"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectIndex"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择索引文件" />

            <TextView
                android:id="@+id/tvIndexRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderIndexRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="1"
                android:stepSize="0.01" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFloat"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="启动悬浮麦克风" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloud"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="在线变声 (云端API)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocalConvert"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="转换本地音频" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRvcRealtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:text="快速变声（录音→自动→外放）" />

            <TextView
                android:id="@+id/tvRvcResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textIsSelectable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
